{
  "name": "metaahorro",
  "version": "1.0.0",
  "description": "API REST serverless de metas de ahorro (Node.js + TypeScript + AWS Lambda + PostgreSQL)",
  "author": "Sofía Celeste Palacio Mercado",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "serverless offline",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "node scripts/e2e.mjs",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "package": "serverless package",
    "deploy": "serverless deploy",
    "remove": "serverless remove"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.24.0",
    "jest": "^29.7.0",
    "serverless": "^3.39.0",
    "serverless-esbuild": "^1.54.5",
    "serverless-offline": "^13.8.3",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
